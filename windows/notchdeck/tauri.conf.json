{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotchDeck",
  "version": "1.24.1",
  "identifier": "com.notchdeck.windows",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Mr-Who-Root/notchdeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QkVBMkFGODk1NEY1MTAKUldRUTlWU0pyNksrRnhVaFFqYjZSOVdnbkYyR2Q2cy9zOUh5bGprcVoxL0VTRWtJVHRIRVR0cVEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
